* fpinit.a - link the MC6839 IEEE floating-point package (FPO9) at startup.
*
* crt0 calls _fpinit after the data area is zeroed / before main, and _fpterm
* after main returns.  A program opts in to it (over the fpdummy.a no-op) at
* link time when it uses floating point - host: fpinit.o via c3lw -f or c3-ld
* -l=...fp.l; OS-9: -l=/dd/lib/fp.l ahead of clib.l.  A program that doesn't
* opt in gets fpdummy and so never links FPO9.
*
* MC6839 module:  name "FPO9", type/language $B1.  Its named entries sit at
* fixed offsets from the module base:  FPREG at +$3D, FPSTAK at +$3F.  We
* F$Link it (it must be resident); if it is not yet loaded we F$Load it from
* /DD/Modules.  The results live in crt0's data area (Y-relative):
*   _fpmod  = module base (for F$UnLink)
*   _fpreg  = base + $3D   _fpstak = base + $3F
*   _fpcb   = 5-byte control block, CTL=$29 (double | NRM | nearest | affine)
 psect fpinit_a,0,0,0,0,0

FPO9TY  equ $b1                 FPO9 module type/language
FPCBCTL equ $29                 double precision, normalised, round-nearest, affine

_fpinit:
 leax fpname,pcr                X = module name "FPO9"
 lda #FPO9TY
 pshs y                         preserve the data base across the syscall
 os9 F$Link                     U = module base, or carry set + B = error
 puls y
 bcc fphave
 cmpb #E$MNF                    not resident yet?
 bne fpfail                     any other link error is fatal
 leax fppath,pcr                X = "/DD/Modules/FPO9"
 lda #FPO9TY
 pshs y
 os9 F$Load                     load it from disk, U = module base
 puls y
 bcs fpfail
fphave:
 stu _fpmod,y                   remember the base for F$UnLink
 leax $3d,u
 stx _fpreg,y                   FPREG  = base + $3D
 leax $3f,u
 stx _fpstak,y                  FPSTAK = base + $3F
 lda #FPCBCTL
 sta _fpcb,y                    control byte (must be nonzero)
 clr _fpcb+1,y                  ENB
 clr _fpcb+2,y                  ERR
 clr _fpcb+3,y                  SS
 clr _fpcb+4,y                  TRAPV
 rts

* FPO9 unavailable: leave _fpmod/_fpreg zero and return, so the program still
* starts.  Its first FP op will then fault; the fix is to install FPO9 (see
* fppath).
fpfail:
 ldd #0
 std _fpmod,y
 std _fpreg,y
 rts

* OS-9 name strings end with the high bit set on the last character
fpname fcc "FPO"
 fcb '9'+$80
fppath fcc "/DD/Modules/FPO"
 fcb '9'+$80


_fpterm:
 ldu _fpmod,y                   module base, 0 if FP was never linked
 beq fptdone
 pshs y
 os9 F$UnLink
 puls y
fptdone rts

 endsect
